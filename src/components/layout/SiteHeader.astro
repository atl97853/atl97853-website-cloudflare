---
import { Image } from 'astro:assets';
import bannerImg from "@images/banner_img.jpg";

import ThemeControls from "./ThemeControls.astro";
---

<header class="site-header">
    <div class="site-toolbar">
        <a class="site-identity" href="/">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                    fill="currentColor"
                    d="M3 10.5 12 3l9 7.5v9A1.5 1.5 0 0 1 19.5 21H15v-6H9v6H4.5A1.5 1.5 0 0 1 3 19.5v-9Z"
                />
            </svg>
            <span>atl97853</span>
        </a>

        {/* When you restore the wordmark, restore the three-column declaration as well. */}
        {/* <span class="site-wordmark" aria-hidden="true"></span> */}

        <ThemeControls />
    </div>

    <div class="site-banner">
        <Image
            class="site-banner__image"
            src={bannerImg}
            alt=""
            priority
        />
    </div>
</header>

<style>
    .site-header {
        padding-top: var(--space-sm);
    }

    .site-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        min-height: 3rem;
        align-items: center;
        gap: var(--space-md);
        margin-inline: calc(var(--site-gutter) * -1);
        margin-bottom: var(--space-lg);
        padding: var(--space-xs) var(--site-gutter);
        border-bottom: 1px solid var(--border);
        background: color-mix(
            in srgb,
            var(--container-bg) 96%,
            var(--card-bg) 4%
        );
    }

    .site-identity {
        display: inline-flex;
        width: max-content;
        align-items: center;
        gap: var(--space-sm);
        color: var(--text-muted);
        font-size: var(--font-xs);
        font-weight: var(--fw-bold);
        text-decoration: none;
    }

    .site-identity svg {
        width: 1rem;
        height: 1rem;
    }

    /* .site-wordmark {
        color: var(--link-main);
        font-size: var(--font-xs);
        font-weight: var(--fw-bold);
        letter-spacing: 0.03em;
        text-transform: lowercase;
    } */

    .site-banner {
        margin: 0 0 var(--space-lg);
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card-bg);
        box-shadow: var(--shadow);
    }

    .site-banner__image {
        width: 100%;
        height: 145px;
        object-fit: cover;
    }

    @media (max-width: 38rem) {
        /* redundant? */
        /* .site-toolbar {
            grid-template-columns: 1fr auto;
        } */

        .site-wordmark {
            display: none;
        }

        .site-banner__image {
            height: 115px;
        }
    }
</style>