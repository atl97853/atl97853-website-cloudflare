{/*
 * BaseLayout sets the initial theme before the page renders, using the saved
 * preference or the system setting. ThemeControls then lets the user change
 * the theme, saves the new preference, and keeps the buttons synchronized.
 */}
<script>
    const STORAGE_KEY = "site-theme";

    type Theme = "dark" | "light";

    function isTheme(value: string | undefined): value is Theme {
        return value === "dark" || value === "light";
    }

    class ThemeControlsElement extends HTMLElement {
        private handleClick = (event: Event) => {
            const target = event.target;

            if (!(target instanceof Element)) return;

            const button = target.closest<HTMLButtonElement>(
                "[data-theme-value]",
            );

            const theme = button?.dataset.themeValue;

            if (!isTheme(theme)) return;

            this.setTheme(theme);
        };

        connectedCallback() {
            this.addEventListener("click", this.handleClick);

            const theme = document.documentElement.dataset.theme;

            this.sync(isTheme(theme) ? theme : "dark");
        }

        disconnectedCallback() {
            this.removeEventListener("click", this.handleClick);
        }

        private setTheme(theme: Theme) {
            document.documentElement.dataset.theme = theme;
            this.sync(theme);

            try {
                localStorage.setItem(STORAGE_KEY, theme);
            } catch {
                // The selected theme still works for the current page.
            }
        }

        private sync(theme: Theme) {
            this.querySelectorAll<HTMLButtonElement>(
                "[data-theme-value]",
            ).forEach((button) => {
                button.setAttribute(
                    "aria-pressed",
                    String(button.dataset.themeValue === theme),
                );
            });
        }
    }

    if (!customElements.get("theme-controls")) {
        customElements.define(
            "theme-controls",
            ThemeControlsElement,
        );
    }
</script>

{/*
BaseLayout sets data-theme before the page renders, so CSS can
immediately style the active theme button.

ThemeControls then synchronizes aria-pressed after hydration.
This prevents button flicker without hiding the component or
causing layout shift.
*/}
<style>
    .theme-controls {
        display: flex;
        justify-self: end;
        align-items: center;
        gap: 2px;
        padding: 4px;
        border-radius: 5px;
        background: color-mix(
            in srgb,
            var(--link-main) 13%,
            transparent
        );
    }

    .theme-control {
        display: inline-grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        border: 0;
        border-radius: 4px;
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
        text-decoration: none;
    }

    .theme-control svg {
        width: 1rem;
        height: 1rem;
    }

    .theme-control:hover {
        background: var(--surface-soft);
        color: var(--link-hover);
    }

    :global(html[data-theme="dark"])
        .theme-control[data-theme-value="dark"],
    :global(html[data-theme="light"])
        .theme-control[data-theme-value="light"] {
        background: var(--theme-active-bg);
        color: var(--theme-active-text);
        box-shadow: inset 0 0 0 1px rgb(0 0 0 / 10%);
    }
</style>