---
/**
 * Homepage profile and welcome card.
 *
 * The `bodyClass` prop injects a component-specific hook into the body element
 * rendered internally by Card.astro. This allows the profile layout to be
 * customized without adding a reusable variant to the Card primitive.
 */

import { Image } from "astro:assets";

import pfp from "../images/pfp_avatar.jpg";
import Card from "./primitives/Card.astro";

const description = `
    Hi, my name is <strong>Atl</strong>, and this is my personal
    website. Here I write about my studies, technology, books I’ve read,
    and other things I find interesting. Feel free to wander around.
`
---

<Card
    as="section"
    title="Welcome to my website!"
    titleId="welcome-card-title"
    bodyClass="u-flex c-pfp-card__body"
>
    <div class="c-pfp">
        <a href="/" aria-label="Go to homepage">
            <Image
                src={pfp}
                alt=""
                width={100}
                height={100}
                loading="eager"
                decoding="sync"
                fetchpriority="high"
            />
        </a>
    </div>

    <div class="c-intro">
        <p set:html={description} />
    </div>
</Card>

<style>
    {/*
     * This hook is attached to `.c-card__body`, which is rendered inside
     * Card.astro. It must therefore escape this component's local style scope.
     */}
    :global(.c-pfp-card__body) {
        align-items: center;
    }

    .c-pfp {
        flex: 0 0 auto;
        width: var(--size-pfp);
        height: var(--size-pfp);
        margin-bottom: var(--space-md);
        overflow: hidden;
        background: var(--clr-bg-card);
    }

    .c-pfp img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        image-rendering: pixelated;
    }

    .c-intro {
        flex: 1;
        min-width: 0;
        align-self: center;
    }

    .c-intro p {
        max-width: var(--component-pfp-intro-max-width);
        margin: var(--space-none);
        line-height: var(--lh-text);
        overflow-wrap: break-word;
    }

    @media (min-width: 48em) {
        .c-pfp {
            margin-inline-end: var(--space-lg);
            margin-bottom: var(--space-none);
        }
    }

    @media (max-width: 560px) {
        :global(.c-pfp-card__body) {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .c-pfp {
            margin-inline: auto;
        }

        .c-intro {
            width: 100%;
            align-self: center;
        }
    }
</style>