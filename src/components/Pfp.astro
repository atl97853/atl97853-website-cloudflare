---
import { Image } from "astro:assets";

import Card from "./primitives/Card.astro";

import pfp from "../images/pfp_avatar.jpg";
---

<Card
    title="Welcome to my website!"
    titleId="welcome-card-title"
    class="c-card--welcome"
    bodyClass="u-flex"
>
    <div class="c-pfp">
        <a href="/" aria-label="Go to homepage">
            <Image
                src={pfp}
                alt="Pfp avatar"
                loading="eager"
                decoding="sync"
            />
        </a>
    </div>

    <div class="c-intro">
        <p>
            Hi, my name is <b>Atl</b>, and this is my personal website. Here I
            write about my studies, technology, books I’ve read, and other
            things I find interesting. Feel free to wander around.
        </p>
    </div>
</Card>

<style>
    .c-card--welcome .c-card__body {
        align-items: center;
    }
    
    .c-pfp {
        flex-shrink: 0;
        width: var(--size-pfp);
        height: var(--size-pfp);
        margin-bottom: var(--space-md);
        overflow: hidden;
    }

    .c-pfp img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        image-rendering: pixelated;
    }

    .c-card--welcome .c-pfp {
        flex: 0 0 auto;
    }

    .c-card--welcome .c-intro {
        flex: 1;
        min-width: 0;
        align-self: center;
    }

    .c-card--welcome .c-intro p {
        max-width: var(--component-pfp-intro-max-width);
        margin: var(--space-none);
        line-height: var(--lh-text);
        overflow-wrap: break-word;
    }

    @media (min-width: 48em) {
        .c-pfp {
            margin-right: var(--space-lg);
            margin-bottom: var(--space-none);
        }
    }

    @media (max-width: 560px) {
        .c-card--welcome .c-card__body {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .c-card--welcome .c-pfp {
            margin-inline: auto;
        }

        .c-card--welcome .c-intro {
            width: 100%;
            align-self: center;
        }
    }
</style>