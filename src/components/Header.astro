---
const githubUrl = "https://github.com/atl97853";
---

<header class="c-site-header" role="banner">
    <h1 class="c-site-header__title"></h1>
    <div
        class="theme-switcher"
        role="group"
        aria-label="External links and theme selection"
    >
        <a
            href={githubUrl}
            class="theme-switcher__control theme-switcher__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="icon github-icon"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    fill="currentColor"
                    d="M12 0C5.37 0 0 5.5 0 12.28c0 5.42 3.44 10.02 8.2 11.64.6.11.82-.27.82-.59v-2.08c-3.34.74-4.04-1.64-4.04-1.64-.55-1.4-1.34-1.77-1.34-1.77-1.09-.76.08-.75.08-.75 1.21.09 1.85 1.27 1.85 1.27 1.07 1.88 2.82 1.34 3.5 1.02.11-.8.42-1.34.76-1.65-2.67-.31-5.47-1.36-5.47-6.07 0-1.34.47-2.44 1.24-3.3-.13-.31-.54-1.57.12-3.27 0 0 1.01-.33 3.31 1.26A11.35 11.35 0 0 1 12 5.96c1.02.01 2.05.14 3.02.41 2.3-1.59 3.31-1.26 3.31-1.26.66 1.7.25 2.96.12 3.27.77.86 1.24 1.96 1.24 3.3 0 4.72-2.81 5.76-5.49 6.06.43.38.82 1.13.82 2.28v3.31c0 .32.22.71.83.59A12.14 12.14 0 0 0 24 12.28C24 5.5 18.63 0 12 0Z"
                ></path>
            </svg>
        </a>

        <button
            type="button"
            class="theme-switcher__control theme-switcher__button"
            theme-btn="dark"
            aria-label="Dark mode"
            aria-pressed="false"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="icon"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>

        <button
            type="button"
            class="theme-switcher__control theme-switcher__button"
            theme-btn="light"
            aria-label="Light mode"
            aria-pressed="false"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="icon"
                aria-hidden="true"
                focusable="false"
            >
                <circle
                    cx="12"
                    cy="12"
                    r="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                <path
                    d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>
    </div>
</header>
<style>
    .c-site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: clamp(0.3rem, 1vw, 0.5rem) clamp(1rem, 5vw, 2rem);
        background-color: var(--clr-bg-container, #0a0a0a);
    }
    .c-site-header__title {
        margin: 0;
        color: var(--clr-accent, currentColor);
        font-family: var(--font-header, monospace);
        font-size: 1.1rem;
    }
    .theme-switcher {
        --control-hover-color: #f2a3c4;
        --control-hover-bg: rgba(128, 128, 128, 0.16);
        --control-hover-shadow:
            0 0 6px rgba(128, 128, 128, 0.3), 0 0 16px rgba(128, 128, 128, 0.16);
        --control-focus-ring: #f2a3c4;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px;
        background: var(--clr-bg-page, transparent);
        border: 1px solid var(--clr-border, transparent);
        border-radius: 8px;
    }
    :global([theme="dark"]) .theme-switcher {
        --control-hover-bg: rgba(255, 255, 255, 0.1);
        --control-hover-shadow:
            0 0 6px rgba(255, 255, 255, 0.5), 0 0 16px rgba(255, 255, 255, 0.24);
    }
    :global([theme="light"]) .theme-switcher {
        --control-hover-bg: rgba(0, 0, 0, 0.08);
        --control-hover-shadow:
            0 0 6px rgba(0, 0, 0, 0.35), 0 0 16px rgba(0, 0, 0, 0.18);
    }
    .theme-switcher__control {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 6px;
        margin: 0;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: var(--clr-text-muted, #888888);
        cursor: pointer;
        line-height: 0;
        text-decoration: none;
        appearance: none;
        -webkit-appearance: none;
        transition:
            color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
            background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
            transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .theme-switcher__control:hover {
        color: var(--control-hover-color);
        background-color: var(--control-hover-bg);
        box-shadow: var(--control-hover-shadow);
        transform: translateY(-1px);
    }
    .theme-switcher__control:focus-visible {
        color: var(--control-hover-color);
        background-color: var(--control-hover-bg);
        box-shadow: var(--control-hover-shadow);
        transform: translateY(-1px);
        outline: 2px solid var(--control-focus-ring);
        outline-offset: 2px;
    }
    .theme-switcher__button.is-active {
        color: var(--clr-bg-page, #000000);
        background-color: var(--clr-text-main, #ffffff);
        box-shadow: var(--control-hover-shadow);
    }
    .theme-switcher__button.is-active:hover,
    .theme-switcher__button.is-active:focus-visible {
        color: #f2a3c4;
        background-color: var(--clr-text-main, #ffffff);
    }
    .theme-switcher__control:disabled,
    .theme-switcher__control[aria-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.45;
        transform: none;
        box-shadow: none;
    }
    .icon {
        width: 18px;
        height: 18px;
        display: block;
        flex-shrink: 0;
        pointer-events: none;
    }
    .github-icon {
        width: 18px;
        height: 18px;
    }
    @media (forced-colors: active) {
        .theme-switcher {
            border: 1px solid ButtonBorder;
        }
        .theme-switcher__control {
            color: ButtonText;
            forced-color-adjust: auto;
        }
        .theme-switcher__control:focus-visible,
        .theme-switcher__button.is-active {
            outline: 2px solid SelectedItem;
            outline-offset: 2px;
        }
        .theme-switcher__button.is-active {
            color: SelectedItemText;
            background-color: SelectedItem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .theme-switcher__control {
            transition: none;
        }
        .theme-switcher__control:hover,
        .theme-switcher__control:focus-visible {
            transform: none;
        }
    }
</style>
<script is:inline>
    (function () {
        const root = document.documentElement;
        const buttons = document.querySelectorAll("[theme-btn]");
        const storageKey = "selected-theme";
        const fallbackTheme = "dark";
        const validThemes = new Set(["dark", "light"]);
        function getStoredTheme() {
            try {
                return localStorage.getItem(storageKey);
            } catch {
                return null;
            }
        }
        function setStoredTheme(theme) {
            try {
                localStorage.setItem(storageKey, theme);
            } catch {
                return;
            }
        }
        function normalizeTheme(theme) {
            return validThemes.has(theme) ? theme : fallbackTheme;
        }
        function applyTheme(theme) {
            const nextTheme = normalizeTheme(theme);
            root.setAttribute("theme", nextTheme);
            setStoredTheme(nextTheme);
            buttons.forEach((button) => {
                const isActive = button.getAttribute("theme-btn") === nextTheme;
                button.classList.toggle("is-active", isActive);
                button.setAttribute("aria-pressed", String(isActive));
            });
        }
        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                applyTheme(button.getAttribute("theme-btn"));
            });
        });
        applyTheme(getStoredTheme());
    })();
</script>
