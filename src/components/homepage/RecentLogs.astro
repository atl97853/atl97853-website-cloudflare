---
import Panel from "@components/primitives/Panel.astro";
import latestLogs from "@content/logs/recent_logs.json";

interface LogEntry {
    date?: string;
    description?: string;
    text?: string;
}

interface NormalizedLogEntry {
    date: string;
    formattedDate: string;
    description: string;
}

const LOG_LIMIT = 7;

const MONTH_NAMES = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
] as const;

const logEntries = latestLogs satisfies LogEntry[];

function formatDate(date: string): string {
    const match = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);

    if (!match) return date;

    const [, year, month, day] = match;
    const monthName = MONTH_NAMES[Number(month) - 1];

    if (!monthName) return date;

    return `${day}, ${monthName}, ${year}`;
}

function normalizeLog(log: LogEntry): NormalizedLogEntry | null {
    const date = log.date?.trim() ?? "";
    const description = (log.description ?? log.text)?.trim() ?? "";

    if (!date || !description) return null;

    return {
        date,
        formattedDate: formatDate(date),
        description,
    };
}

const logs = logEntries
    .map(normalizeLog)
    .filter((log): log is NormalizedLogEntry => log !== null)
    .sort((firstLog, secondLog) => secondLog.date.localeCompare(firstLog.date))
    .slice(0, LOG_LIMIT);
---

<Panel 
    as="section" 
    class="recent-logs" 
    title="Recent logs"
>
    {
        logs.length > 0 ? (
            <ol class="recent-logs__ol">
                {logs.map((log) => (
                    <li class="recent-logs__li">
                        <time
                            class="recent-logs__date"
                            datetime={log.date}
                        >
                            {log.formattedDate}
                        </time>

                        <p class="recent-logs__description">
                            {log.description}
                        </p>
                    </li>
                ))}
            </ol>
        ) : (
            <p class="recent-logs__empty">
                No updates available at the moment.
            </p>
        )
    }
</Panel>

<style>
    /* Scoped Panel heading override */
    .recent-logs {
        padding: 0;
    }

    .recent-logs > :global(.panel__heading) {
        margin: 0;
        padding: 0.82rem var(--space-md);
        border-bottom: 1px solid var(--border);
    }
    /* Scoped Panel heading override */
    .recent-logs__ol {
        display: grid;
        margin: 0;
        padding: 0.18rem 0;
        list-style: none;
    }

    .recent-logs__li {
        display: grid;
        grid-template-columns: minmax(0, 1fr) max-content;
        align-items: baseline;
        column-gap: var(--space-xs);
        padding: 0.2rem var(--space-md);
    }

    .recent-logs__li + .recent-logs__li {
        border-top: 1px dotted var(--border);
    }

    /* .recent-logs__li:hover {
        background: var(--surface-hover);
    } */

    .recent-logs__date {
        grid-column: 2;
        grid-row: 1;
        /* delete later */
        /* display: block; */
        color: var(--link-main);
        font-size: var(--font-sm);
        font-weight: var(--fw-semibold);
        font-variant-numeric: tabular-nums;
        line-height: var(--reading-line-height);
        text-align: end;
        white-space: nowrap;
    }

    .recent-logs__description {
        grid-column: 1;
        grid-row: 1;
        margin: 0;
        color: var(--text-main);
        font-size: var(--font-sm);
        line-height: var(--reading-line-height);
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .recent-logs__empty {
        margin: 0;
        padding: var(--space-md);
        color: var(--text-muted);
        font-size: var(--font-sm);
        line-height: var(--reading-line-height);
    }

    @media (max-width: 38rem) {
        .recent-logs__li {
            padding-inline: var(--space-sm);
            /* if necessary, stack the date above the description only at very small widths */
            /* grid-template-columns: minmax(0, 1fr) max-content; */
        }
    }
</style>