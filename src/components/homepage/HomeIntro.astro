---
import { Image } from "astro:assets";
import avatar from "@images/avatar_image.jpg";

import Panel from "@components/primitives/Panel.astro";

const title = "Welcome to my website!";
---

<Panel as="section" title={title}>
    <div class="home-intro__layout">
        <Image
            class="home-intro__avatar"
            src={avatar}
            alt=""
            width={100}
            height={100}
            densities={[1.5, 2]}
            priority
        />

        <p class="home-intro__description">
            Hi, my name is <strong>Atl</strong>, and this is my personal
            website. Here I write about my studies, technology, books I’ve
            read, and other things I find interesting. Feel free to wander
            around.
        </p>
    </div>
</Panel>

<style>
    .home-intro__layout {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: var(--space-lg);
    }

    .home-intro__avatar {
        width: 100px;
        height: 100px;
        border: 3px solid var(--card-bg);
        border-radius: 11px;
        outline: 1px solid var(--border-strong);
        object-fit: cover;
    }

    .home-intro__description {
        max-width: var(--reading-width);
        line-height: var(--reading-line-height);
        font-size: var(--font-sm);
        overflow-wrap: anywhere;
    }

    @media (max-width: 38rem) {
        .home-intro__layout {
            grid-template-columns: 1fr;
            gap: var(--space-md);
        }

        .home-intro__avatar {
            justify-self: center;
        }
    }
</style>