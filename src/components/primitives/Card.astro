---
/**
 * Card component
 *
 * Reusable semantic wrapper for standardized card-like sections across the site.
 * It renders a configurable HTML element through the `as` prop, such as
 * `section`, `article`, `nav`, `aside`, or `div`.
 *
 * The component can render either a simple title through the `title` prop or a
 * custom named `header` slot. When a visible header exists, it connects the card
 * to that heading with `aria-labelledby`. When no visible header exists, it can
 * use `ariaLabel` instead.
 *
 * The body content is rendered through the default slot inside `.c-card__body`.
 * Extra classes can be added to the outer card with `class` and to the body with
 * `bodyClass`, allowing each component to keep a shared structure while still
 * supporting small layout/style variations.
 */

interface Props {
    as?: "section" | "article" | "nav" | "aside" | "div";
    title?: string;
    titleId?: string;
    class?: string;
    bodyClass?: string;
    headingLevel?: 2 | 3 | 4;
    ariaLabel?: string;
}

const {
    as = "section",
    title,
    titleId,
    class: className,
    bodyClass,
    headingLevel = 2,
    ariaLabel,
} = Astro.props;

const slugify = (value: string) => {
    const slug = value
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");

    return slug || undefined;
};

const hasHeaderSlot = Astro.slots.has("header");
const normalizedTitle = title?.trim();
const hasTitle = Boolean(normalizedTitle);
const hasHeader = hasTitle || hasHeaderSlot;

const titleSlug = normalizedTitle ? slugify(normalizedTitle) : undefined;
const headingId = titleId?.trim() || (titleSlug ? `${titleSlug}-title` : undefined);

const Tag = as;
const Heading = `h${headingLevel}` as const;

const labelledBy = hasHeader && headingId ? headingId : undefined;
const label = labelledBy ? undefined : ariaLabel;
---

<Tag
    class:list={["c-card", className]}
    aria-labelledby={labelledBy}
    aria-label={label}
>
    {
        hasHeader && (
            <Heading id={headingId} class="c-card__header">
                {hasHeaderSlot ? <slot name="header" /> : normalizedTitle}
            </Heading>
        )
    }

    <div class:list={["c-card__body", bodyClass]}>
        <slot />
    </div>
</Tag>