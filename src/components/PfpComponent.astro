---
import { Image } from "astro:assets";
import pfp from "../images/pfp_avatar.jpg";
---

<section class="c-card c-card--welcome" aria-labelledby="welcome-card-title">
    <h2 id="welcome-card-title" class="c-card__header">welcome to my site!</h2>

    <div class="c-card__body u-flex">
        <div class="c-pfp">
            <a href="/" aria-label="Go to homepage">
                <Image
                    src={pfp}
                    alt="Avatar illustration of Atl"
                    decoding="async"
                />
            </a>
        </div>

        <div class="c-intro">
            <p>
                <p>
                    Hi, my name is <b>Atl</b>, and this is my personal site. I
                    use this space to write about things I am learning, projects
                    I am building, and anything else I like or find
                    interesting. Feel free to wander around. ⸜(｡˃ ᵕ ˂ )⸝♡
                </p>
            </p>
        </div>
    </div>
</section>
