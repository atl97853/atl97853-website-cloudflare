---
import { Image } from "astro:assets";
import pfp from "../images/pfp_avatar.jpg";
---

<section class="c-card c-card--welcome" aria-labelledby="welcome-card-title">
    <h2 id="welcome-card-title" class="c-card__header">
        welcome to my website!
    </h2>

    <div class="c-card__body u-flex">
        <div class="c-pfp">
            <a href="/" aria-label="Go to homepage">
                <Image
                    src={pfp}
                    alt="Avatar illustration of Atl"
                    decoding="async"
                />
            </a>
        </div>

        <div class="c-intro">
            <p>
                Hi, my name is <b>Atl</b>, and this is my personal website. I
                use this space to write about what I’m studying, share things I
                like, and keep notes on books, courses, code, and projects. Feel
                free to wander around. ⸜(｡˃ ᵕ ˂ )⸝♡
            </p>
        </div>
    </div>
</section>
