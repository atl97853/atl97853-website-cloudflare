---
import { Image } from "astro:assets";
import pfp from "../images/pfp_avatar.jpg";
---

<section class="c-card c-card--welcome" aria-labelledby="welcome-card-title">
    <h2 id="welcome-card-title" class="c-card__header">
        welcome to my website!
    </h2>

    <div class="c-card__body u-flex">
        <div class="c-pfp">
            <a href="/" aria-label="Go to homepage">
                <Image
                    src={pfp}
                    alt="Avatar illustration of Atl"
                    decoding="async"
                />
            </a>
        </div>

        <div class="c-intro">
            <p>
                Hi, my name is <b>Atl</b>, and this is my personal website. Here I
                write about my studies, technology, books I’ve read, and other
                things I find interesting. Feel free to wander around.
            </p>
        </div>
    </div>
</section>

<style>
    .c-card--welcome .c-card__body {
        align-items: center;
    }

    .c-card--welcome .c-intro {
        flex: 1;
        min-width: 0;
        align-self: center;
    }

    .c-card--welcome .c-intro p {
        max-width: 42rem;
        margin: 0;
        line-height: 1.5;
        overflow-wrap: break-word;
    }

    @media (max-width: 560px) {
        .c-card--welcome .c-card__body {
            align-items: flex-start;
        }
    }
</style>