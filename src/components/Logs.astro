---
import Card from "./primitives/Card.astro";

import latestLogs from "../content/data/logs/latest_logs.json";

interface LogEntry {
    date?: string;
    time?: string;
    text?: string;
}

interface NormalizedLogEntry {
    date: string;
    time: string;
    text: string;
    marker: string;
    dateTime: string;
    hasDate: boolean;
}

const LOG_LIMIT = 5;

function normalizeText(value?: string): string {
    return typeof value === "string" ? value.trim() : "";
}

function formatDate(date: string): string {
    const match = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);

    if (!match) {
        return date;
    }

    const [, year, month, day] = match;
    return `${day}.${month}.${year.slice(2)}`;
}

function getDateTimeValue(date: string, time: string): string {
    if (date && time) {
        return `${date}T${time}`;
    }

    return date || time;
}

const logs: NormalizedLogEntry[] = Array.isArray(latestLogs)
    ? (latestLogs as LogEntry[])
          .map((log) => {
              const date = normalizeText(log.date);
              const time = normalizeText(log.time);
              const text = normalizeText(log.text);
              const hasDate = date.length > 0;

              return {
                  date,
                  time,
                  text,
                  hasDate,
                  marker: hasDate ? formatDate(date) : time,
                  dateTime: getDateTimeValue(date, time),
              };
          })
          .filter((log) => log.marker.length > 0 && log.text.length > 0)
          .slice(0, LOG_LIMIT)
    : [];

const hasLogs = logs.length > 0;
---

<Card titleId="logs-title">
    <a
        slot="header"
        class="c-logs-card__title-link"
        href="https://nownownow.com/about"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Read about now pages. Opens in a new tab."
    >
        Update log
    </a>

    {
        hasLogs ? (
            <ul class="c-log" aria-label="latest updates">
                {logs.map((log) => (
                    <li class="c-log__item">
                        <time class="c-log__marker" datetime={log.dateTime}>
                            {log.marker}:
                        </time>{" "}

                        <span class="c-log__text">{log.text}</span>

                        {log.hasDate && log.time && (
                            <>
                                {" "}
                                <time
                                    class="c-log__time"
                                    datetime={log.dateTime}
                                >
                                    {log.time}
                                </time>
                            </>
                        )}
                    </li>
                ))}
            </ul>
        ) : (
            <p class="c-log__empty">No updates available at the moment.</p>
        )
    }
</Card>

<style>
    .c-logs-card__title-link,
    .c-logs-card__title-link:visited,
    .c-logs-card__title-link:hover,
    .c-logs-card__title-link:active {
        color: inherit;
        text-decoration: var(--component-log-title-link-decoration);
    }

    .c-logs-card__title-link {
        cursor: pointer;
    }

    .c-logs-card__title-link:focus-visible {
        outline: var(--component-log-focus-outline-width)
            var(--component-log-focus-outline-style) currentColor;
        outline-offset: var(--component-log-focus-outline-offset);
    }

    .c-log {
        margin: var(--space-none);
        padding: var(--component-log-space-before) var(--space-none)
            var(--space-none);
        list-style: var(--component-log-list-style);
    }

    .c-log__item {
        margin: var(--space-none);
        line-height: var(--lh-log);
        text-wrap: pretty;
        overflow-wrap: anywhere;
    }

    .c-log__item + .c-log__item {
        margin-top: var(--component-log-item-space-before);
    }

    .c-log__marker {
        font-weight: var(--fw-bold);
        white-space: nowrap;
    }

    .c-log__time {
        color: var(--clr-text-muted);
        font-size: var(--fs-xs);
        white-space: nowrap;
    }

    .c-log__empty {
        margin: var(--space-none);
        color: var(--clr-text-muted);
        overflow-wrap: break-word;
    }

    @media (max-width: 560px) {
        .c-log__marker,
        .c-log__time {
            white-space: normal;
        }
    }
</style>