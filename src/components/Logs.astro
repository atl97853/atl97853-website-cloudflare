---
/**
 * Displays the ten most recent valid log entries.
 */

import latestLogs from "../content/data/logs/latest_logs.json";
import Card from "./primitives/Card.astro";

interface LogEntry {
    date?: string;
    time?: string;
    text?: string;
}

interface NormalizedLogEntry {
    marker: string;
    markerDateTime: string;
    time: string;
    dateTime: string;
    text: string;
}

const LOG_LIMIT = 10;

const MONTH_NAMES = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
] as const;

const logEntries = latestLogs satisfies LogEntry[];

function formatDate(date: string): string {
    const match = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);

    if (!match) {
        return date;
    }

    const [, year, month, day] = match;
    const monthName = MONTH_NAMES[Number(month) - 1];

    if (!monthName) {
        return date;
    }

    return `${day} ${monthName}, ${year}`;
}

function normalizeLog(log: LogEntry): NormalizedLogEntry | null {
    const date = log.date?.trim() ?? "";
    const time = log.time?.trim() ?? "";
    const text = log.text?.trim() ?? "";

    if (!text || (!date && !time)) {
        return null;
    }

    return {
        marker: date ? formatDate(date) : time,
        markerDateTime: date || time,
        time: date ? time : "",
        dateTime: date && time ? `${date}T${time}` : date || time,
        text,
    };
}

const logs = logEntries
    .map(normalizeLog)
    .filter((log): log is NormalizedLogEntry => log !== null)
    .slice(0, LOG_LIMIT);
---

<Card title="Update log">
    {
        logs.length > 0 ? (
            <ul class="c-log">
                {logs.map((log) => (
                    <li class="c-log__item">
                        <div class="c-log__row">
                            <time
                                class="c-log__date"
                                datetime={log.markerDateTime}
                            >
                                {log.marker}
                                {"-"}
                            </time>

                            <span class="c-log__entry">
                                <span class="c-log__text">{log.text}</span>

                                {log.time && (
                                    <>
                                        {" "}
                                        <time
                                            class="c-log__time"
                                            datetime={log.dateTime}
                                        >
                                            {log.time}
                                        </time>
                                    </>
                                )}
                            </span>
                        </div>
                    </li>
                ))}
            </ul>
        ) : (
            <p class="c-log__empty">
                No updates available at the moment.
            </p>
        )
    }
</Card>

<style>
    .c-log {
        margin: var(--space-none);
        padding-block-start: var(--component-log-space-before);
        padding-inline-start: var(--space-lg);
        color: var(--clr-text-main);
        list-style: disc;
    }

    .c-log__item {
        margin: var(--space-none);
        line-height: var(--lh-log);
    }

    .c-log__item + .c-log__item {
        margin-top: var(--component-log-item-space-before);
    }

    .c-log__row {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: var(--space-sm);
        align-items: baseline;
    }

    .c-log__date {
        color: var(--clr-text-main);
        font-weight: var(--fw-bold);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .c-log__entry {
        min-width: 0;
        text-wrap: pretty;
        overflow-wrap: anywhere;
    }

    .c-log__time {
        color: var(--clr-text-muted);
        font-size: var(--fs-xs);
        white-space: nowrap;
    }

    .c-log__empty {
        margin: var(--space-none);
        color: var(--clr-text-muted);
        overflow-wrap: break-word;
    }

    @media (max-width: 560px) {
        .c-log__row {
            grid-template-columns: 1fr;
            gap: var(--space-none);
        }

        .c-log__date,
        .c-log__time {
            white-space: normal;
        }
    }
</style>