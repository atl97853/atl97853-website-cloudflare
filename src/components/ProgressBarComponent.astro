---
interface Skill {
    name: string;
    level: number;
}

const rawSkills: Skill[] = [
    { name: "B.S. in Computer Systems Engineering", level: 0 },
    { name: "English proficiency (B2)", level: 40 },
];

function clampLevel(level: number): number {
    return Number.isFinite(level) ? Math.min(100, Math.max(0, level)) : 0;
}

function formatLevel(level: number): string {
    return Number.isInteger(level) ? `${level}%` : `${level.toFixed(2)}%`;
}

function getProgressId(name: string, index: number): string {
    const slug = name
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

    return `progress-${slug || index}`;
}

const skills = rawSkills.map((skill) => ({
    ...skill,
    level: clampLevel(skill.level),
}));
---

<section class="c-card c-progress-card" aria-labelledby="progress-title">
    <h2 id="progress-title" class="c-card__header c-progress-card__title">
        progress
    </h2>

    <div class="c-card__body c-progress-card__body">
        <div class="c-progress-list">
            {
                skills.map((skill, index) => {
                    const progressId = getProgressId(skill.name, index);
                    const nameId = `${progressId}-name`;
                    const valueId = `${progressId}-value`;
                    const formattedLevel = formatLevel(skill.level);

                    return (
                        <div class="c-progress-item">
                            <div class="c-progress-meta">
                                <span id={nameId} class="c-progress-name">
                                    {skill.name}
                                </span>

                                <span id={valueId} class="c-progress-value">
                                    {formattedLevel}
                                </span>
                            </div>

                            <div
                                class="c-progress-track"
                                role="progressbar"
                                aria-labelledby={`${nameId} ${valueId}`}
                                aria-valuemin="0"
                                aria-valuemax="100"
                                aria-valuenow={skill.level}
                                aria-valuetext={formattedLevel}
                            >
                                <div
                                    class="c-progress-fill"
                                    style={`--progress-value: ${skill.level}%;`}
                                />
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    .c-progress-card {
        --progress-track: rgba(0, 0, 0, 0.14);
        --progress-fill: var(--clr-accent, currentColor);
    }

    :global([theme="dark"]) .c-progress-card {
        --progress-track: rgba(255, 255, 255, 0.18);
        --progress-fill: #ffffff;
    }

    .c-progress-card__body {
        padding-top: var(--space-xs, 4px);
    }

    .c-progress-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-md, 16px);
    }

    .c-progress-item {
        min-width: 0;
    }

    .c-progress-meta {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        gap: var(--space-sm, 8px);
        margin-bottom: var(--space-xs, 4px);
    }

    .c-progress-name {
        min-width: 0;
        overflow-wrap: break-word;
    }

    .c-progress-value {
        color: var(--clr-text-muted, currentColor);
        font-size: var(--fs-xs, 0.875rem);
        white-space: nowrap;
    }

    .c-progress-track {
        width: 100%;
        height: 3px;
        overflow: hidden;
        background: var(--progress-track);
    }

    .c-progress-fill {
        width: var(--progress-value);
        height: 100%;
        background: var(--progress-fill);
    }
</style>