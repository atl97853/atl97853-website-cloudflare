---
import latestLogs from "../content/data/logs/latest_logs.json";

interface LogEntry {
    date?: string;
    time?: string;
    text?: string;
}

interface NormalizedLogEntry {
    date: string;
    time: string;
    text: string;
    marker: string;
    dateTime: string;
    hasDate: boolean;
}

const LOG_LIMIT = 5;

function normalizeText(value?: string): string {
    return typeof value === "string" ? value.trim() : "";
}

function formatDate(date: string): string {
    const match = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);

    if (!match) {
        return date;
    }

    const [, year, month, day] = match;
    return `${day}.${month}.${year.slice(2)}`;
}

function getDateTimeValue(date: string, time: string): string {
    if (date && time) {
        return `${date}T${time}`;
    }

    return date || time;
}

const logs: NormalizedLogEntry[] = Array.isArray(latestLogs)
    ? (latestLogs as LogEntry[])
          .map((log) => {
              const date = normalizeText(log.date);
              const time = normalizeText(log.time);
              const text = normalizeText(log.text);
              const hasDate = date.length > 0;

              return {
                  date,
                  time,
                  text,
                  hasDate,
                  marker: hasDate ? formatDate(date) : time,
                  dateTime: getDateTimeValue(date, time),
              };
          })
          .filter((log) => log.marker.length > 0 && log.text.length > 0)
          .slice(0, LOG_LIMIT)
    : [];

const hasLogs = logs.length > 0;
---

<section class="c-card c-logs-card" aria-labelledby="logs-title">
    <h2 id="logs-title" class="c-card__header c-logs-card__title">
        <a
            class="c-logs-card__title-link"
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Read about now pages. Opens in a new tab."
        >
            update log
        </a>
    </h2>

    <div class="c-card__body c-logs-card__body">
        {
            hasLogs ? (
                <ul class="c-log" aria-label="latest updates">
                    {logs.map((log) => (
                        <li class="c-log__item">
                            <time
                                class="c-log__marker"
                                datetime={log.dateTime}
                            >
                                {log.marker}:
                            </time>{" "}

                            <span class="c-log__text">{log.text}</span>

                            {log.hasDate && log.time && (
                                <>
                                    {" "}
                                    <time
                                        class="c-log__time"
                                        datetime={log.dateTime}
                                    >
                                        {log.time}
                                    </time>
                                </>
                            )}
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="c-log__empty">No updates available at the moment.</p>
            )
        }
    </div>
</section>

<style>
    .c-logs-card__title {
        margin: 0;
    }

    .c-logs-card__title-link,
    .c-logs-card__title-link:visited,
    .c-logs-card__title-link:hover,
    .c-logs-card__title-link:active {
        color: inherit;
        text-decoration: none;
    }

    .c-logs-card__title-link {
        cursor: pointer;
    }

    .c-logs-card__title-link:focus-visible {
        outline: 1px dotted currentColor;
        outline-offset: 2px;
    }

    .c-logs-card__body {
        padding-top: var(--space-xs, 4px);
    }

    .c-log {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .c-log__item {
        margin: 0;
        line-height: 1.45;
        text-wrap: pretty;
        overflow-wrap: anywhere;
    }

    .c-log__item + .c-log__item {
        margin-top: var(--space-xs, 4px);
    }

    .c-log__marker {
        font-weight: 700;
        white-space: nowrap;
    }

    .c-log__time {
        color: var(--clr-text-muted, currentColor);
        font-size: var(--fs-xs, 0.875rem);
        white-space: nowrap;
    }

    .c-log__empty {
        margin: 0;
        color: var(--clr-text-muted, currentColor);
        overflow-wrap: break-word;
    }

    @media (max-width: 560px) {
        .c-log__marker,
        .c-log__time {
            white-space: normal;
        }
    }
</style>