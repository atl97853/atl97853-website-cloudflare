---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/primitives/Card.astro";
---

<BaseLayout tabTitle="colophon">
    <Card
        slot="custom-cards"
        title="About my blog"
        titleId="colophon-title"
    >
        <p>
            If you've reached this page, it means you've been exploring my site
            thoroughly. For the moment, this place is "secret." Here I'll write
            about the process of how I created my website.
            <br />
            For now, just a hint:
            <a
                href="https://astro.build/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Astro!
            </a>
        </p>
    </Card>
</BaseLayout>