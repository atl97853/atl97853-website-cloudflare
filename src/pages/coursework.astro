---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/primitives/Card.astro";
import ProgressBar from "../components/ProgressBar.astro";

import coursework from "../content/data/coursework/coursework.json";

type CourseStatus = "incomplete" | "in-progress" | "completed";

interface Course {
    code?: string;
    title?: string;
    status?: string;
}

interface SeasonGroup {
    season?: string;
    courses?: Course[];
}

const visibleStatuses = new Set<CourseStatus>(["in-progress", "completed"]);
const validStatuses = new Set<CourseStatus>([
    "incomplete",
    "in-progress",
    "completed",
]);

function normalizeText(value?: string): string {
    return typeof value === "string" ? value.trim() : "";
}

function normalizeStatus(status?: string): CourseStatus {
    const normalized = normalizeText(status).toLowerCase().replace(/\s+/g, "-");

    return validStatuses.has(normalized as CourseStatus)
        ? (normalized as CourseStatus)
        : "incomplete";
}

function getSeasonId(season: string, index: number): string {
    const slug = season
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

    return `season-${slug || index}`;
}

const rawCoursework = Array.isArray(coursework)
    ? (coursework as SeasonGroup[])
    : [];

const seasonGroups = rawCoursework
    .map((group) => {
        const courses = Array.isArray(group.courses)
            ? group.courses
                  .map((course) => {
                      const code = normalizeText(course.code);
                      const title = normalizeText(course.title);
                      const status = normalizeStatus(course.status);

                      return { code, title, status };
                  })
                  .filter(
                      (course) =>
                          course.title.length > 0 &&
                          visibleStatuses.has(course.status)
                  )
            : [];

        return {
            season: normalizeText(group.season),
            courses,
        };
    })
    .filter((group) => group.season.length > 0 && group.courses.length > 0);

const hasCoursework = seasonGroups.length > 0;
---

<BaseLayout tabTitle="coursework">
    <Card
        slot="custom-cards"
        as="article"
        title="Coursework"
        titleId="coursework-title"
        class="c-coursework-card"
        bodyClass="c-coursework-card__body"
    >
        {
            hasCoursework ? (
                seasonGroups.map((season, index) => {
                    const seasonId = getSeasonId(season.season, index);

                    return (
                        <section class="c-season-group" aria-labelledby={seasonId}>
                            <h2 id={seasonId} class="c-season-title">
                                {season.season}
                            </h2>

                            <ul
                                class="c-course-list"
                                aria-label={`${season.season} coursework`}
                            >
                                {season.courses.map((course) => (
                                    <li
                                        class="c-course-item"
                                        data-status={course.status}
                                    >
                                        <span class="c-course-name">
                                            {course.code && (
                                                <span class="c-course-code">
                                                    {course.code}:{" "}
                                                </span>
                                            )}

                                            <span>{course.title}</span>
                                        </span>

                                        {course.status === "completed" && (
                                            <span class="u-sr-only">
                                                completed
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    );
                })
            ) : (
                <p class="c-coursework-empty">
                    I'm currently in the process of transitioning between
                    universities and organizing my credits, so there's nothing
                    available here at the moment.
                </p>
            )
        }
    </Card>

    <ProgressBar slot="custom-cards-aside" />
</BaseLayout>

<style>
    :global(.c-coursework-card) {
        --course-completed: var(--clr-text-muted);
    }

    :global([theme="dark"] .c-coursework-card) {
        --course-completed: rgba(255, 255, 255, 0.72);
    }

    :global(.c-coursework-card__body) {
        max-width: 48rem;
        /* padding-top: var(--space-md); */
        line-height: 1.45;
    }

    .c-season-group + .c-season-group {
        margin-top: var(--space-lg);
    }

    .c-season-title {
        margin: 0 0 var(--space-sm);
        color: var(--clr-text-main);
        font-size: var(--fs-sm);
        font-style: italic;
        font-weight: 700;
        line-height: 1.35;
        overflow-wrap: break-word;
    }

    .c-course-list {
        margin: 0;
        padding-left: 1.35rem;
        list-style: disc;
    }

    .c-course-item {
        padding-left: 0.15rem;
        color: var(--clr-text-main);
    }

    .c-course-item + .c-course-item {
        margin-top: 0.4rem;
    }

    .c-course-name {
        overflow-wrap: anywhere;
    }

    .c-course-code {
        font-weight: 700;
    }

    .c-course-item[data-status="completed"] {
        color: var(--course-completed);
    }

    .c-course-item[data-status="completed"] .c-course-name {
        text-decoration: line-through;
        text-decoration-thickness: var(--bw-frame);
        text-decoration-color: currentColor;
    }

    .c-coursework-empty {
        margin: 0;
        color: var(--clr-text-muted);
        overflow-wrap: break-word;
    }

    .u-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>