---
import { Image } from 'astro:assets';
import pfp from '../images/pfp_avatar.jpg';
---

<section class="c-card c-card--welcome">
    <div class="c-card__header">welcome to my site!</div>
    <div class="c-card__body u-flex">
        <div class="c-pfp">
            <Image src={pfp} alt="pfp-image" />
        </div>
        <div class="c-intro">
            <p>
                hello there! my name is 
                <b>Atl</b>, and this is my digital garden. 
                in this space i will share things related to math, computers, and things i simply like and find interesting.
                feel free to wander around and make yourself at home ⸜(｡˃ ᵕ ˂ )⸝♡
            </p>
        </div>
    </div>
</section>