<style>
    .c-log {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .c-log__item {
        padding: 12px 5px;
        border-bottom: 1px dotted var(--clr-border);
    }

    .c-log__item:last-child {
        border-bottom: none;
    }

    .blog-date {
        font-size: var(--fs-sm);
        color: var(--text-main);
    }

    .blog-title {
        display: block;
        font-size: var(--fs-sm); 
        font-weight: bold;
        color: var(--text-main);
        text-decoration: none;
        margin-bottom: var(--space-xs);
    }

    .blog-title:hover {
        color: var(--clr-accent);
        padding-left: var(--space-sm);
        text-decoration: underline;
    }

    .blog-summary {
        font-size: var(--fs-sm);
        color: var(--text-main);
        font-style: italic;
        display: block;
        line-height: 1.3;
    }
</style>

