---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from "astro:content";
import {formatDate} from '../utils';

const allBlogPosts: CollectionEntry<'blog'>[] = (await getCollection('blog'))
    .sort((a:CollectionEntry<'blog'>, b:CollectionEntry<'blog'>) => b.data.
    pubDate.valueOf() - a.data.pubDate.valueOf());
---

<style>
    .c-card__body {
        padding-top: var(--space-xs); /* new, this overrides its global style */
    }

    .c-log {
        padding: 0;
        margin: 0;
    }

    .c-log__item {
        padding: 12px 5px;
        border-bottom: 1px dotted var(--clr-border);
    }

    .c-log__item:last-child {
        border-bottom: none;
    }

    .blog-date {
        font-size: var(--fs-sm);
        color: var(--text-main);
    }

    .blog-title {
        display: block;
        font-size: var(--fs-sm); 
        font-weight: bold;
        color: var(--text-main);
        text-decoration: none;
        margin-bottom: var(--space-xs);
    }

    .blog-title:hover {
        color: var(--clr-accent);
        padding-left: var(--space-sm);
        text-decoration: underline;
    }

    .blog-summary {
        font-size: var(--fs-sm);
        color: var(--text-main);
        font-style: italic;
        display: block;
        line-height: 1.3;
    }
</style>

<section class="c-card">
    <div class="c-card__header">Recent Posts</div>
    <div class="c-card__body">
        <ul class="c-log">
            {allBlogPosts.map(post => (
                <li class="c-log__item">
                    <div class="blog-date">{formatDate(post.data.pubDate)}</div>
                    <a href={'/blog/' + post.slug} class="blog-title">{post.data.title}</a>
                    <span class="blog-summary">{post.data.summary}</span>
                </li>
            ))}
        </ul>
    </div>
</section>