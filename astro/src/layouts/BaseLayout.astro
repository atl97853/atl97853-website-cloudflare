---
import '../styles/global.css';
import { Image } from 'astro:assets';
import pfp from '../images/pfp_avatar.jpg';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>bunicore.exe // 2004_archive</title>
    <!-- <link rel="stylesheet" href="./style.css"> -->
</head>
<body>

<div class="l-main-wrapper">
    <header class="c-site-header">
        <h1 class="c-site-header__title">あなたのことをわすれません</h1>
    </header>

    <div class="l-layout-grid">
        <main class="l-content">
            <section class="c-card c-card--welcome">
                <div class="c-card__header">welcome to my site!</div>
                <div class="c-card__body u-flex">
                    <div class="c-pfp">
                        <Image src={pfp} alt="pfp-image" />
                    </div>
                    <div class="c-intro">
                        <p>hello there! my name is <b>buni</b> and this is my safe place. i spend my time studying algorithms and watching 2000s anime.</p>
                    </div>
                </div>
            </section>

            <section class="c-card">
                <div class="c-card__header">update log</div>
                <div class="c-card__body">
                    <ul class="c-log">
                        <li class="c-log__item"><b>09.12.24:</b> welcome to the site! i opened today.</li>
                    </ul>
                </div>
            </section>

            <section class="c-card">
                <div class="c-card__header">about the webmaster</div>
                <div class="c-card__body">
                    <p>hello im buni! im a 19yo CS major. i love oldweb design and magical girls.</p>
                </div>
            </section>
        </main>

        <aside class="l-sidebar">
            <nav class="c-card c-card--sidebar">
                <div class="c-card__header">navigation</div>
                <ul class="c-nav-list">
                    <li><a href="#" class="c-nav-list__link">➹ homepage</a></li>
                    <li><a href="#" class="c-nav-list__link">➹ about me</a></li>
                    <li><a href="#" class="c-nav-list__link">➹ virtual diary</a></li>
                </ul>
            </nav>

            <!-- <section class="c-card c-card--sidebar">
                <div class="c-card__header">add my button!</div>
                <div class="c-card__body u-text-center">
                    <div class="c-badge">bunicore</div>
                    <textarea class="c-input--readonly" readonly><a href="bunicore.neocities.org">...</a></textarea>
                </div>
            </section> -->
        </aside>
    </div>

    <footer class="c-site-footer">
        BUNICORE 2024 © All rights reserved !!!
    </footer>
</div>

</body>
</html>